<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd は ~ や $HOME を展開しないため、パスはすべて絶対パスである必要がある。
  このファイルはテンプレートで、install.sh がパスを実環境の値に置換して
  ~/Library/LaunchAgents へ書き出す。直接配置しても動作しない。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.scansnap-obsidian-local</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/bin/scan_to_obsidian_local_v2.sh</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>__INCOMING_DIR__</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/scan_to_obsidian.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/scan_to_obsidian.stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
