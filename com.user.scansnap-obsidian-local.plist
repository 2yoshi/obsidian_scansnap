<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.scansnap-obsidian-local</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/pooh/bin/scan_to_obsidian_local_v2.sh</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>/Users/pooh/syncthing/notes/001_scanbox/_incoming</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/pooh/Library/Logs/scan_to_obsidian.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pooh/Library/Logs/scan_to_obsidian.stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
